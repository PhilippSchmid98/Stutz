{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "start-scrcpy",
            "type": "shell",
            "command": "scrcpy --always-on-top  -S",
            "isBackground": true,
            "problemMatcher": [
                {
                    "pattern": [
                        {
                            "regexp": ".",
                            "file": 1,
                            "location": 2,
                            "message": 3
                        }
                    ],
                    "background": {
                        "activeOnStart": true,
                        "beginsPattern": ".*",
                        "endsPattern": ".*"
                    }
                }
            ],
            "presentation": {
                "reveal": "silent"
            }
        }
    ]
}